#!/bin/sh
# Fetch the upstream artifacts pinned in Upstream/manifest.json — @qeetrix/ui from npm, the native
# fonts from their releases, the icon drawings from qeetrix-icons — verify them, and rewrite
# Upstream/manifest.lock.json. The only step that touches the network.
#
#   Scripts/sync-tokens           refresh the snapshot and lock
#   Scripts/sync-tokens --check   compare upstream with the lock; change nothing
#
# After a sync, run Scripts/generate-tokens.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
check=""
[ "${1:-}" = "--check" ] && check=" --check"
exec "$root/gradlew" -p "$root" --quiet --console=plain :qeetrix-gen:run --args="sync --root $root$check"
