#!/bin/sh
# Fetch the npm tarballs pinned in Upstream/manifest.json — @qeetrix/tokens (the DTCG tokens and the
# native TrueType fonts), @qeetrix/react (the component manifest and CSS) and @qeetrix/icons — verify
# them against the registry and fonts/native.json, and rewrite Upstream/manifest.lock.json. The only
# step that touches the network.
#
#   Scripts/sync-tokens           refresh the snapshot and lock
#   Scripts/sync-tokens --check   compare upstream with the lock; change nothing
#
# After a sync, run Scripts/generate-tokens.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
check=""
[ "${1:-}" = "--check" ] && check=" --check"
exec "$root/gradlew" -p "$root" --quiet --console=plain :qeetrix-gen:run --args="sync --root $root$check"
