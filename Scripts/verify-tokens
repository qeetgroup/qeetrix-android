#!/bin/sh
# Fail if the upstream snapshot differs from its lock, or if any generated file is not exactly what
# the snapshot generates (edited by hand, stale, or left over). Offline. Also part of ./gradlew check.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
exec "$root/gradlew" -p "$root" --quiet --console=plain :qeetrix-gen:verify
