#!/usr/bin/env python3
"""List what Qeetrix brings into an app: every artifact of the locked release runtime classpath
(qeetrix/gradle.lockfile) with the licence its own POM declares, following parent POMs. POMs come from Gradle's
module cache, or — Gradle often reads only module metadata — from the artifact's repository (Google's Maven for
androidx and com.google, Maven Central otherwise). A POM that names no licence is listed as unknown, never guessed.
Exits 1 if any licence is unknown or not in the allowed list, so a new dependency is reviewed before a release.

    Scripts/dependency-inventory [output.md] [--cyclonedx output.cdx.json --version X.Y.Z]
                                                 (reads POMs missing from the cache over the network)

With --cyclonedx it also writes a CycloneDX 1.5 SBOM of the artifact: Qeetrix itself, the fonts and icon artwork
bundled in it (with the hashes Upstream/manifest.lock.json records), and every runtime dependency above.
"""
import glob
import json
import os
import sys
import uuid
import urllib.request
import xml.etree.ElementTree as ET

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CACHE = os.path.join(os.environ.get('GRADLE_USER_HOME', os.path.expanduser('~/.gradle')), 'caches', 'modules-2', 'files-2.1')
NS = {'m': 'http://maven.apache.org/POM/4.0.0'}
# Licences reviewed for distribution inside apps (Documentation/Releases/LICENSE-COMPLIANCE.md).
ALLOWED = {
    'The Apache Software License, Version 2.0',
    'The Apache License, Version 2.0',
    'Apache-2.0',
    'Apache License, Version 2.0',
    'Apache License 2.0',
}


def pom(group, artifact, version):
    found = glob.glob(os.path.join(CACHE, group, artifact, version, '*', f'{artifact}-{version}.pom'))
    if found:
        return ET.parse(found[0]).getroot()
    repository = 'https://dl.google.com/android/maven2' if group.startswith(('androidx.', 'com.google.')) else 'https://repo1.maven.org/maven2'
    url = f"{repository}/{group.replace('.', '/')}/{artifact}/{version}/{artifact}-{version}.pom"
    try:
        with urllib.request.urlopen(url, timeout=30) as response:
            return ET.fromstring(response.read())
    except OSError:
        return None


def licences(group, artifact, version, depth=0):
    root = pom(group, artifact, version)
    if root is None:
        return None
    names = [n.text.strip() for n in root.findall('m:licenses/m:license/m:name', NS) if n.text]
    if names or depth > 4:
        return names
    parent = root.find('m:parent', NS)
    if parent is None:
        return []
    return licences(parent.findtext('m:groupId', namespaces=NS), parent.findtext('m:artifactId', namespaces=NS),
                    parent.findtext('m:version', namespaces=NS), depth + 1)


rows, problems = [], []
for line in open(os.path.join(ROOT, 'qeetrix', 'gradle.lockfile')):
    if '=' not in line or line.startswith('#'):
        continue
    coordinate, configurations = line.strip().split('=', 1)
    if 'releaseRuntimeClasspath' not in configurations.split(','):
        continue
    group, artifact, version = coordinate.split(':')
    names = licences(group, artifact, version)
    licence = '; '.join(names) if names else 'unknown'
    if not names or not any(n in ALLOWED for n in names):
        problems.append(f'{coordinate}: {licence}')
    rows.append((coordinate, licence))

out = ['# Qeetrix runtime dependencies', '',
       'Generated by `Scripts/dependency-inventory` from `qeetrix/gradle.lockfile` (release runtime classpath) and each',
       "artifact's own POM. Every artifact here reaches an app that depends on Qeetrix.", '',
       f'{len(rows)} artifacts.', '', '| Artifact | Licence (from its POM) |', '|:--|:--|']
out += [f'| `{c}` | {l} |' for c, l in sorted(rows)]
text = '\n'.join(out) + '\n'
args = sys.argv[1:]
cyclonedx = version = None
if '--cyclonedx' in args:
    i = args.index('--cyclonedx')
    cyclonedx = args[i + 1]
    del args[i:i + 2]
if '--version' in args:
    i = args.index('--version')
    version = args[i + 1]
    del args[i:i + 2]
if args:
    with open(args[0], 'w') as f:
        f.write(text)
    print(f'{"✓" if not problems else "✗"} {len(rows)} runtime artifacts written to {args[0]}')
elif not cyclonedx:
    print(text)

if cyclonedx:
    if not version:
        sys.exit('error: --cyclonedx needs --version')
    lock = json.load(open(os.path.join(ROOT, 'Upstream', 'manifest.lock.json')))
    icons = lock['qeetrixIcons']
    components = [
        {
            'type': 'file', 'bom-ref': f'font-{font["family"]}', 'name': os.path.basename(font['destination']),
            'description': f'{font["webFamily"]} ({font["repository"]} {font["tag"]}), bundled unmodified in the AAR with its licence.',
            'hashes': [{'alg': 'SHA-256', 'content': font['ttfSHA256']}],
            'licenses': [{'expression': 'OFL-1.1'}],
            'externalReferences': [{'type': 'vcs', 'url': f'https://github.com/{font["repository"]}'}],
        }
        for font in lock['fonts']
    ]
    components.append({
        'type': 'data', 'bom-ref': 'qeetrix-icons', 'name': icons['package'], 'version': icons['version'],
        'description': f'Icon artwork at {icons["repository"]}@{icons["commit"][:7]}, compiled to Kotlin path data; includes Lucide (ISC) and Feather (MIT) drawings.',
        'licenses': [{'expression': 'MIT AND ISC'}],
        'externalReferences': [{'type': 'vcs', 'url': f'https://github.com/{icons["repository"]}'}],
    })
    for coordinate, licence in sorted(rows):
        group, artifact, ver = coordinate.split(':')
        components.append({
            'type': 'library', 'bom-ref': coordinate, 'group': group, 'name': artifact, 'version': ver,
            'purl': f'pkg:maven/{group}/{artifact}@{ver}',
            'licenses': [{'license': {'name': name}} for name in licence.split('; ')],
        })
    bom = {
        'bomFormat': 'CycloneDX', 'specVersion': '1.5', 'serialNumber': f'urn:uuid:{uuid.uuid4()}', 'version': 1,
        'metadata': {'component': {
            'type': 'library', 'bom-ref': 'qeetrix', 'group': 'com.qeetgroup', 'name': 'qeetrix', 'version': version,
            'purl': f'pkg:maven/com.qeetgroup/qeetrix@{version}',
            'description': "Qeet Group's design system for Jetpack Compose, distributed as an AAR through Maven.",
            'licenses': [{'license': {'name': 'No licence chosen (Qeet Group)'}}],
        }},
        'components': components,
        'dependencies': [{'ref': 'qeetrix', 'dependsOn': [c['bom-ref'] for c in components]}],
    }
    with open(cyclonedx, 'w') as f:
        json.dump(bom, f, indent=2)
        f.write('\n')
    print(f'✓ CycloneDX 1.5 SBOM with {len(components)} components written to {cyclonedx}')
if problems:
    print('error: licences to review:\n  ' + '\n  '.join(problems), file=sys.stderr)
    sys.exit(1)
