{
  "$comment": "What qeetrix-android is built from: the npm-published @qeetrix/tokens, @qeetrix/react and @qeetrix/icons, the same pins as qeetrix-ios, with Android destinations. Edit a pin, then run Scripts/sync-tokens: it fetches these exact tarballs, checks each against the registry's integrity hash, takes the TrueType fonts @qeetrix/tokens ships for native platforms (checked against its fonts/native.json) and rewrites Upstream/manifest.lock.json. Nothing else in Upstream/ is edited by hand. Repository paths are relative to the repository root; package paths are inside the npm tarball.",
  "qeetrixTokens": {
    "package": "@qeetrix/tokens",
    "version": "0.0.15",
    "dtcg": "package/dist/dtcg",
    "destination": "Upstream/qeetrix-tokens/dtcg",
    "componentTokens": [
      "sidebar",
      "timeline"
    ]
  },
  "qeetrixReact": {
    "package": "@qeetrix/react",
    "version": "0.5.1",
    "manifest": "package/dist/manifest.json",
    "manifestDestination": "Upstream/qeetrix-react/component-manifest.json",
    "css": "package/dist/css",
    "cssDestination": "Upstream/qeetrix-react/css",
    "families": [
      "accordion",
      "avatar",
      "badge",
      "base",
      "button",
      "card",
      "checkbox",
      "dialog",
      "drawer",
      "field",
      "fieldset",
      "heading",
      "input",
      "link",
      "menu",
      "popover",
      "progress",
      "radio",
      "select",
      "separator",
      "skeleton",
      "slider",
      "spinner",
      "state",
      "switch",
      "tabs",
      "text",
      "text-field",
      "toast",
      "toggle",
      "tooltip",
      "experimental/alert",
      "experimental/app-shell",
      "experimental/avatar-group",
      "experimental/avatar-item",
      "experimental/calendar",
      "experimental/check-list",
      "experimental/combobox",
      "experimental/copy-button",
      "experimental/copy-field",
      "experimental/date-picker",
      "experimental/date-range-picker",
      "experimental/description-list",
      "experimental/empty-state",
      "experimental/file-upload",
      "experimental/filter-tags",
      "experimental/form",
      "experimental/number-field",
      "experimental/otp-input",
      "experimental/page-header",
      "experimental/password-input",
      "experimental/qr-code",
      "experimental/range-calendar",
      "experimental/relative-time",
      "experimental/search-field",
      "experimental/sidebar",
      "experimental/stat",
      "experimental/steps",
      "experimental/timeline",
      "experimental/top-bar"
    ]
  },
  "fonts": [
    {
      "family": "sans",
      "webFamily": "Qeet Sans",
      "ttf": "package/dist/fonts/QeetSans.ttf",
      "axes": [
        "GEOM",
        "opsz",
        "wght"
      ],
      "destination": "qeetrix/src/main/res/font/qx_qeet_sans_vf.ttf",
      "licenseDestination": "qeetrix/src/main/assets/qeetrix/licenses/QeetSans-OFL.txt"
    },
    {
      "family": "mono",
      "webFamily": "Fira Code",
      "ttf": "package/dist/fonts/FiraCode-VF.ttf",
      "axes": [
        "wght"
      ],
      "destination": "qeetrix/src/main/res/font/qx_fira_code_vf.ttf",
      "licenseDestination": "qeetrix/src/main/assets/qeetrix/licenses/FiraCode-OFL.txt"
    }
  ],
  "nativeFonts": "package/dist/fonts/native.json",
  "qeetrixIcons": {
    "package": "@qeetrix/icons",
    "version": "2.1.2",
    "manifest": "package/dist/manifest.json",
    "svg": "package/dist/svg",
